# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI provider (Vercel AI SDK) — set one
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Postgres (Neon): DATABASE_URL = pooled string (host has -pooler), DIRECT_URL = same with pooling off
DATABASE_URL=
DIRECT_URL=

# Signs Tollgate access tokens (any long random string)
TOLLGATE_TOKEN_SECRET=

# KERNEL cloud browsers (sponsor credits)
KERNEL_API_KEY=

# AI models (optional overrides)
AI_MODEL_PRICING=gemini-3.8-flash
AI_MODEL_AGENT=gemini-3.5-flash-lite

# Public demo guardrails (DEMO_MODE defaults to true)
DEMO_MODE=true
# Sandbox PayPal account that receives every demo cash-out
DEMO_PAYOUT_EMAIL=

# Public site URL (optional; Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_BASE_URL=
