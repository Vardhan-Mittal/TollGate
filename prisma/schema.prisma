generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Amounts are integer US cents everywhere. Ledger accounts are strings:
// "agent:<id>", "publisher:<id>" or "platform".

model Publisher {
  id           String     @id @default(cuid())
  name         String
  domain       String
  paypalEmail  String?
  balanceCents Int        @default(0)
  createdAt    DateTime   @default(now())
  resources    Resource[]
  payouts      Payout[]
  deals        Deal[]
}

model Resource {
  id              String        @id @default(cuid())
  publisherId     String
  publisher       Publisher     @relation(fields: [publisherId], references: [id])
  path            String        @unique
  title           String
  description     String
  body            String
  teaser          String
  priceReadCents  Int
  priceTrainCents Int
  // The AI's latest suggestion. Live prices follow it unless the publisher overrides.
  aiPriceReadCents  Int?
  aiPriceTrainCents Int?
  priceOverridden   Boolean @default(false)
  aiReasoning     String?
  valueScore      Int?
  publishedAt     DateTime
  createdAt       DateTime      @default(now())
  quotes          Quote[]
  grants          AccessGrant[]
  visits          BotVisit[]
}

model Agent {
  id               String        @id @default(cuid())
  name             String
  operatorEmail    String?
  apiKeyHash       String        @unique
  apiKeyPrefix     String
  balanceCents     Int           @default(0)
  dailyBudgetCents Int?
  createdAt        DateTime      @default(now())
  quotes           Quote[]
  grants           AccessGrant[]
  topUps           TopUp[]
  deals            Deal[]

  // PayPal vault token saved with the operator's consent; used for auto-recharge.
  paypalVaultId              String?
  paypalCustomerId           String?
  autoRechargeThresholdCents Int?
  autoRechargeAmountCents    Int?
}

enum License {
  READ
  TRAIN
}

enum QuoteStatus {
  OPEN
  PAID
}

model Quote {
  id         String       @id @default(cuid())
  resourceId String
  resource   Resource     @relation(fields: [resourceId], references: [id])
  agentId    String?
  agent      Agent?       @relation(fields: [agentId], references: [id])
  license    License
  priceCents Int
  // Who asked: the bot user-agent or Tollgate-Agent name, kept even if never paid.
  botName    String?
  status     QuoteStatus  @default(OPEN)
  expiresAt  DateTime
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  grant      AccessGrant?
}

model AccessGrant {
  id         String   @id @default(cuid())
  quoteId    String   @unique
  quote      Quote    @relation(fields: [quoteId], references: [id])
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  license    License
  priceCents Int
  createdAt  DateTime @default(now())
}

enum LedgerKind {
  TOPUP
  CHARGE
  EARNING
  FEE
  PAYOUT
  PAYOUT_REVERSAL
  LICENSE_SALE
}

model LedgerEntry {
  id             String     @id @default(cuid())
  account        String
  kind           LedgerKind
  amountCents    Int
  quoteId        String?
  externalRef    String?
  idempotencyKey String?    @unique
  createdAt      DateTime   @default(now())

  @@index([account, createdAt])
}

enum VisitOutcome {
  QUOTED
  PAID_ACCESS
  FREE_ACCESS
}

model BotVisit {
  id         String       @id @default(cuid())
  resourceId String?
  resource   Resource?    @relation(fields: [resourceId], references: [id])
  path       String
  userAgent  String
  botName    String?
  outcome    VisitOutcome
  createdAt  DateTime     @default(now())

  @@index([createdAt])
}

enum TopUpStatus {
  CREATED
  COMPLETED
  FAILED
}

model TopUp {
  id            String      @id @default(cuid())
  agentId       String
  agent         Agent       @relation(fields: [agentId], references: [id])
  amountCents   Int
  paypalOrderId String?     @unique
  captureId     String?     @unique
  status        TopUpStatus @default(CREATED)
  automatic     Boolean     @default(false)
  failureReason String?
  createdAt     DateTime    @default(now())
  completedAt   DateTime?

  @@index([agentId, createdAt])
}

enum PayoutStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payout {
  id            String       @id @default(cuid())
  publisherId   String
  publisher     Publisher    @relation(fields: [publisherId], references: [id])
  amountCents   Int
  receiverEmail String
  paypalBatchId String?      @unique
  paypalStatus  String?
  status        PayoutStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// PayPal webhook event ids that were already processed (deduplication).
model WebhookEvent {
  id         String   @id
  eventType  String
  receivedAt DateTime @default(now())
}

enum DealStatus {
  NEGOTIATING
  NO_DEAL
  INVOICED
  PAID
  FAILED
}

// A bulk training license negotiated between a buyer agent and the
// publisher's agent, settled with a PayPal invoice.
model Deal {
  id               String     @id @default(cuid())
  agentId          String
  agent            Agent      @relation(fields: [agentId], references: [id])
  publisherId      String
  publisher        Publisher  @relation(fields: [publisherId], references: [id])
  resourceIds      String[]
  listPriceCents   Int
  budgetCents      Int
  floorCents       Int
  agreedPriceCents Int?
  status           DealStatus @default(NEGOTIATING)
  transcript       Json       @default("[]")
  buyerEmail       String?
  paypalInvoiceId  String?    @unique
  invoiceUrl       String?
  failureReason    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  paidAt           DateTime?
}
